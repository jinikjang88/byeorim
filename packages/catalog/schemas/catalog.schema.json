{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byeorim.dev/schemas/catalog.schema.json",
  "title": "Byeorim Catalog",
  "description": "벼림 도메인 카탈로그. World, Bundle, Block, Dependency, Cascade, Prerequisite로 이루어진다. ADR 0005 참조",
  "type": "object",
  "required": ["worlds", "blocks"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "카탈로그 표시명. 옵션. 도메인을 사람이 읽는 한 줄로"
    },
    "domain": {
      "type": "string",
      "description": "카탈로그 도메인 식별자. 옵션. 디렉토리 이름과 같게 두면 추적이 쉽다"
    },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/world" }
    },
    "bundles": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundle" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "cascades": {
      "type": "array",
      "items": { "$ref": "#/$defs/cascade" }
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/prerequisite" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "소문자, 숫자, 하이픈으로 이루어진 ID. 첫 글자는 영문 소문자"
    },
    "world": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "코드 생성 시 모듈 이름으로 쓰이는 영문 슬러그"
        },
        "icon": { "type": "string" }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["id", "world_id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "world_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "name", "user_desc"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "bundle_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "user_desc": {
          "type": "string",
          "minLength": 1,
          "description": "비기술 창업자가 읽는 일상 언어 설명"
        },
        "tech_desc": {
          "type": "string",
          "description": "엔지니어가 읽는 기술 설명"
        },
        "analogy": { "type": "string" },
        "priority": { "enum": ["required", "optional"] },
        "effort_days": { "type": "number", "minimum": 0 },
        "api_style": { "enum": ["resource", "query", "internal", "singleton"] },
        "path": {
          "type": "string",
          "pattern": "^/[^\\s?#\\\\<>\"'`]+$",
          "description": "REST endpoint path 자리. 옵셔널. 비어있으면 block.id에서 자동 복수화(ADR 0041). 자동 결과가 어색한 자리(mass noun, 동사형 복합어, 싱글톤 자원)를 정밀 조정(ADR 0042). i18n 허용(한국어/일본어/중국어 등 Unicode letters, ADR 0043). 거부: 공백, ?, #, \\, <, >, \", ', `"
        },
        "concerns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "icon": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["source", "target", "type"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["requires", "affects"],
          "description": "requires는 함께 따라와야 하는 블럭, affects는 영향을 받는 블럭"
        },
        "reason": {
          "type": "string",
          "description": "의존이 생기는 이유. condition과 같은 의미"
        },
        "condition": {
          "type": "string",
          "description": "의존이 적용되는 조건. reason과 같은 의미. 통합은 후속 ADR"
        }
      }
    },
    "cascade": {
      "type": "object",
      "required": ["trigger"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "$ref": "#/$defs/id" },
        "add_blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "ask_questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/cascadeQuestion" }
        }
      }
    },
    "cascadeQuestion": {
      "type": "object",
      "required": ["question"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cascade_effects": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "required": ["name", "enables"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "phase": { "type": "string" },
        "where": { "type": "string" },
        "time": { "type": "string" },
        "cost": { "type": "string" },
        "enables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "requires_prereq": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
