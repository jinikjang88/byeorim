  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.11.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.3.3"
  },
  "author": "DevSmith"
}
